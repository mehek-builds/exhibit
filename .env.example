# Exhibit environment variables (PRD 6, 6.13, 6.14, 7.1-7.6). Copy to .env and fill in; never
# commit real values. Every integration below is on ONLY when its own credentials are present;
# `buildLiveDeps` never enables a feature silently and prints a features report at startup.

# --- Founder profile (src/config.ts) ---
# JSON matching the FounderProfile shape in src/types.ts (name, aliases, emails, domain, company,
# githubLogins, ownAccounts, linkedinId, field, targetFilingDate, recommenderCandidates, and the
# optional phone/quietHours/scanSince/coauthors/translationOptIn used by 6.13/6.14).
EXHIBIT_PROFILE=

# --- Google (Gmail, Calendar, Drive, Docs, Sheets) OAuth2, src/apps/live/google.ts ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Override the Google API root, e.g. an Arga twin base URL. Leave unset for the real APIs.
GOOGLE_ROOT_URL=
# The founder's own address; used as the Gmail `From` header on sends and for sharing checks.
EXHIBIT_OWNER_EMAIL=

# --- GitHub, src/apps/live/github.ts (also feeds src/integrations/platformstats.ts, 6.14) ---
GITHUB_TOKEN=
# Override the GitHub API root, e.g. an Arga twin base URL. Leave unset for api.github.com.
GITHUB_BASE_URL=

# --- LinkedIn (Arga twin only; no public API), src/apps/live/linkedin.ts ---
# Unset means no LinkedIn client: the agent records linkedin as degraded (PRD 10).
LINKEDIN_BASE_URL=
LINKEDIN_TOKEN=

# --- Anthropic (classifier/mapper model, the Corroborator's research model, and the 6.13
# AnthropicCommandParser used when set; HeuristicCommandParser otherwise), PRD 6, 6.11, 6.13, 7.5b ---
ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-5 when unset.
EXHIBIT_MODEL=

# --- Release id stamped on every run and trace (PRD 6.10, 12.6) ---
# Defaults to the repo's short git SHA.
EXHIBIT_RELEASE=

# --- Arga twin provisioning for harness runs against hosted twins (PRD 7.1), harness/arga.ts ---
ARGA_API_KEY=
# Override the Arga API root. Leave unset for https://app.argalabs.com.
ARGA_BASE_URL=

# --- Ledger and tracing storage (src/config.ts) ---
# SQLite path for the ledger; defaults to .exhibit/ledger.db in live mode, :memory: in harness mode.
EXHIBIT_LEDGER=
# Local trace JSONL directory for a harness-against-Arga run. Defaults to none.
EXHIBIT_TRACE_DIR=

# ============================================================================================
# 6.13 -- the founder's text channel (SMS/WhatsApp via Twilio)
# ============================================================================================

# src/apps/live/twilio.ts, src/server/webhook.ts, src/commands/serve.ts. All three required to
# enable the text channel; disabled (features report: "disabled: TWILIO_* missing") otherwise.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Alternative to TWILIO_AUTH_TOKEN: an API key (SK...) and its secret. Sends and reads work; the
# webhook needs the auth token to validate signatures, so with only a key `exhibit serve` polls
# for inbound texts every TWILIO_POLL_SECONDS (default 15, minimum 5) instead.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_POLL_SECONDS=
# 'whatsapp:+14155238886' for the Sandbox, or a bare E.164 number for SMS.
TWILIO_SENDER=
# Public base URL Twilio is configured to POST inbound messages to; must match exactly what's
# entered in the Twilio console, used to reconstruct the signed URL for webhook validation.
TWILIO_PUBLIC_URL=
# Port for `exhibit serve`'s webhook HTTP server. Defaults to 8787.
PORT=

# ============================================================================================
# 6.14 -- structured verifier APIs (Corroborator, checked before any web search)
# ============================================================================================

# OpenAlex (works unauthenticated at a lower rate; set to raise it), src/integrations/openalex.ts
OPENALEX_KEY=
# Crossref polite pool; required to enable this adapter (a bare mailto is Crossref's auth model).
CROSSREF_MAILTO=
# Semantic Scholar; optional, works unauthenticated at a lower rate.
SEMANTIC_SCHOLAR_KEY=
# BLS Public Data API v2 registration key, src/integrations/bls.ts (O-1A/EB-1A criterion 8).
BLS_KEY=
# O*NET Web Services credentials, src/integrations/onet.ts (criterion 8).
ONET_USERNAME=
ONET_PASSWORD=
# ecosyste.ms and GitHub/Hugging Face platform stats need no separate key; GITHUB_TOKEN and
# HF_TOKEN above/below raise their rate limits when set.

# ============================================================================================
# 6.14 -- discovery adapters (found evidence the founder never sent Exhibit)
# ============================================================================================

# GDELT and Hacker News (Algolia) need no key.
# Hugging Face Hub; optional, works unauthenticated at a lower rate.
HF_TOKEN=
# Product Hunt API v2 developer token.
PRODUCTHUNT_TOKEN=
# Podcast Index API credentials.
PODCASTINDEX_KEY=
PODCASTINDEX_SECRET=
# USPTO PatentSearch API key.
USPTO_KEY=
# The founder's own OpenReview login (review assignments, PRD 6.14).
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=
# ORCID public API credentials, plus the founder's own ORCID iD.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_ID=
# SEC fair-access policy requires a descriptive contact User-Agent, e.g.
# "Exhibit evidence agent contact@example.com". Required to enable the EDGAR adapter.
SEC_EDGAR_USER_AGENT=

# ============================================================================================
# 6.14 -- tamper-evident binder (archival + timestamping)
# ============================================================================================

# Internet Archive S3-style keys for archive.org save-page-now/archival, src/integrity/archive.ts.
# OpenTimestamps itself needs no credentials; unset here just disables the IA archival leg.
IA_ACCESS_KEY=
IA_SECRET_KEY=

# ============================================================================================
# 6.14 -- letter signature collection (Dropbox Sign)
# ============================================================================================

# src/integrations/dropboxsign.ts, src/letters/signing.ts. Default is "day mode": every request is
# in Dropbox Sign test mode and signers are restricted to profile.controlledEmails (constraint 18).
# Stays in day mode unless BOTH of the next two are set exactly as shown -- never enabled silently.
DROPBOX_SIGN_API_KEY=
# Set to 0, together with EXHIBIT_ALLOW_LIVE_SIGNATURES=1, to opt out of day mode and send real
# (non-test-mode) signature requests. Any other value (including unset) keeps day mode on, so every
# request stays in Dropbox Sign test mode and goes only to a controlled signer address.
DROPBOX_SIGN_TEST_MODE=
EXHIBIT_ALLOW_LIVE_SIGNATURES=

# ============================================================================================
# 6.14 -- draft machine translation (DeepL)
# ============================================================================================

# src/integrations/deepl.ts, src/translate/translate.ts. Only ever called for a source the
# founder explicitly opted in via profile.translationOptIn (see EXHIBIT_PROFILE above); unset
# here disables the extension entirely regardless of that opt-in.
DEEPL_KEY=
